# --- Wallet (only needed for --live) ---
# Private key of the wallet that signs orders. NEVER commit the real .env.
PRIVATE_KEY=
# Address that holds your USDC / positions on Polymarket (your profile/proxy address).
FUNDER_ADDRESS=
# 0 = plain EOA, 1 = Polymarket email/Magic proxy wallet, 2 = browser-wallet Gnosis Safe proxy
SIGNATURE_TYPE=1

# --- Strategy (all optional, defaults shown) ---
MM_MAX_MARKETS=3
MM_QUOTE_SIZE=20            # shares per quote (raised to the market's min order size if lower)
MM_HALF_SPREAD=0.01         # quote this far either side of mid (price units, 0.01 = 1 cent)
MM_SKEW=0.02                # max mid shift when inventory is at the position cap
MM_MAX_POSITION=100         # max shares held of any one outcome token
MM_MAX_OPEN_NOTIONAL=150    # max USDC committed to resting BUY orders across all markets
MM_MIN_VOLUME_24H=20000
MM_MIN_MID=0.15             # skip markets priced outside [MIN_MID, MAX_MID]
MM_MAX_MID=0.85
MM_MIN_DAYS_TO_END=3        # skip markets that resolve sooner than this
MM_MAX_BOOK_SPREAD=0.06     # skip markets whose book is wider than this
MM_MOVE_PAUSE=0.03          # mid jump between cycles that triggers cancel + skip
MM_REFRESH_SECONDS=15
MM_MAX_ERRORS=5             # consecutive failed cycles before cancel-all and exit
